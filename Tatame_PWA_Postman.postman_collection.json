          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('API funcionando', function () {",
                  "    pm.expect(pm.response.json().mensagem).to.eql('API Tatame funcionando');",
